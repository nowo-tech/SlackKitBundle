# PHPStan configuration for Slack Kit Bundle.
#
# Run: make phpstan
parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        - vendor/*
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    # Linker/router methods read host stores: never reuse a remembered call result across state changes in tests.
    rememberPossiblyImpureFunctionValues: false
    ignoreErrors: []

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  # worker-strict includes default worker rules + request-superglobal hygiene (kernel not reset).
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-hardening.neon
