{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The instance settings pages render in the same shell (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Slack Kit Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Slack Kit Bundle Demo</a>
        <nav class="nowo-ui-header__nav" aria-label="Slack Kit Bundle Demo">
            <a href="{{ path('demo_home') }}"{% if app.request.attributes.get('_route') == 'demo_home' %} aria-current="page"{% endif %}>Home</a>
            <a href="{{ path('nowo_instance_settings_index') }}"{% if app.request.attributes.get('_route') starts with 'nowo_instance_settings' %} aria-current="page"{% endif %}>Settings</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# UiKit peers (visible-when, InstanceSettings 1.3): demo Stimulus app. #}
    <script src="{{ asset('js/nowo-ui-demo-peers.js') }}" defer></script>
    {% block javascripts %}{% endblock %}
{% endblock %}
