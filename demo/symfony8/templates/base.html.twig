{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). The instance settings pages render in the same shell (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Slack Kit',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/SlackKitBundle',
    translation_domain: false,
    nav: [
        {label: 'Home', route: 'demo_home', section: 'Demo'},
        {label: 'Settings', route: 'nowo_instance_settings_index', active: ['nowo_instance_settings_*'], section: 'Slack Kit admin'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Slack Kit Demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# UiKit peers (visible-when, InstanceSettings 1.3): demo Stimulus app. #}
    <script src="{{ asset('js/nowo-ui-demo-peers.js') }}" defer></script>
    {% block javascripts %}{% endblock %}
{% endblock %}
